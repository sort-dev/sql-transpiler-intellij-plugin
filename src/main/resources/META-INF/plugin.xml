<idea-plugin>
    <id>dev.sort.sql-transpiler-intellij-plugin</id>
    <name>SQL Transpiler</name>
    <vendor url="https://sort.dev" email="jayson@sort.dev">Sortdev SRL</vendor>
    <description><![CDATA[
        <p>Cross-dialect SQL transpilation inside DataGrip and IntelliJ IDEA Ultimate, powered by
        brikk-sql (a full Kotlin port of sqlglot). Transpile any SQL between MySQL, Doris, Trino,
        Presto, DuckDB, PostgreSQL, ClickHouse, Hive, Spark, DataFusion, and BigQuery, execute it
        against the current engine through transpilation, or work across engines side by side in
        a Brikk SQL scratch.</p>

        <ul>
            <li><b>Execute via transpilation:</b> write a block in one dialect, run it on whatever
                engine the console is attached to — transpile, review the generated SQL and its
                diagnostics, execute; unchanged re-runs skip the review</li>
            <li><b>Transpile To / From:</b> preview as a before/after diff, then replace in place,
                insert after, copy, or send to an open console</li>
            <li><b>Exact diagnostics:</b> unsupported constructs flagged by the generator, plus
                functions the target engine does not register (checked against real engine
                function catalogs)</li>
            <li><b>Brikk SQL scratches (.bsql):</b> one file, many engines. Each block starts with
                <code>-- language=dorissql using="Doris prod"</code> (or any IDE SQL language) and is
                real SQL of that dialect: its highlighting, completion and errors, resolved against
                and run on its own connection with Ctrl+Enter</li>
            <li><b>Pipe syntax (|&gt;):</b> write pipe-syntax SQL and generate standard SQL out of
                it automatically</li>
            <li><b>AST viewer</b> tool window over the brikk-sql expression tree</li>
        </ul>

        <p><i>An independent plugin by Sortdev SRL, built on the open-source
        <a href="https://github.com/brikk/brikk-house">brikk-sql</a> transpiler.</i></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>
    <depends optional="true" config-file="transpiler-kotlin.xml">org.jetbrains.kotlin</depends>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true" supportsK1="false"/>
    </extensions>

    <extensionPoints>
        <extensionPoint name="inspectionHostGuard" interface="dev.sort.sqltranspiler.InspectionHostGuard" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Brikk SQL" displayType="BALLOON"/>

        <!-- BrikkSQL: the plugin-owned polyglot SQL dialect (.bsql files). The host
             grammar is marker comments plus one injection host per block; each block
             gets its `language=` language and its `using=` data source. -->
        <fileType name="Brikk SQL"
                  implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlFileType"
                  fieldName="INSTANCE"
                  language="BrikkSQL"
                  extensions="bsql"/>
        <lang.parserDefinition language="BrikkSQL"
                               implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlParserDefinition"/>
        <lang.syntaxHighlighterFactory language="BrikkSQL"
                                       implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlSyntaxHighlighterFactory"/>
        <lang.commenter language="BrikkSQL"
                        implementationClass="com.intellij.database.sql.common.core.psi.impl.support.SqlNestedCommenter"/>
        <multiHostInjector implementation="dev.sort.sqltranspiler.lang.BrikkSqlBlockInjector" order="first"/>
        <lang.elementManipulator forClass="dev.sort.sqltranspiler.lang.BrikkSqlBlock"
                                 implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlBlockManipulator"/>
        <!-- Marker attribute completion; SQL covers the host and every injected SQL dialect. -->
        <completion.contributor language="SQL" order="first"
                                implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlMarkerCompletionContributor"/>
        <completion.confidence language="SQL" order="first"
                               implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlMarkerCompletionConfidence"/>
        <typedHandler implementation="dev.sort.sqltranspiler.lang.BrikkSqlMarkerTypedHandler" order="first"/>
        <annotator language="BrikkSQL" implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlRunErrorAnnotator"/>
        <editorFactoryListener implementation="dev.sort.sqltranspiler.lang.BrikkSqlCurrentStatementEditorListener"/>
        <sql.dataSourceProvider implementation="dev.sort.sqltranspiler.lang.BrikkSqlBlockDataSourceProvider"/>
        <dynamicActionConfigurationCustomizer implementation="dev.sort.sqltranspiler.lang.BrikkSqlBlockExecuteConfiguration"/>
        <actionPromoter implementation="dev.sort.sqltranspiler.lang.BrikkSqlBlockExecutePromoter" order="first"/>
        <!-- brikk-sql syntax errors for blocks without a real IDE dialect (Generic SQL). -->
        <externalAnnotator language="BrikkSQL"
                           implementationClass="dev.sort.sqltranspiler.lang.BrikkSqlErrorAnnotator"/>

        <!-- Gutter icon on "dialect: xyz" line-comment markers. Registered on the base SQL
             language; LanguageExtension resolution covers every SQL dialect language. -->
        <codeInsight.lineMarkerProvider
                language="SQL"
                implementationClass="dev.sort.sqltranspiler.DialectMarkerLineMarkerProvider"/>

        <!-- "Go Generic SQL" banner for vendor-dialect files containing foreign
             dialect-marker blocks (the polyglot scratch-file workflow). -->
        <editorNotificationProvider
                implementation="dev.sort.sqltranspiler.MixedDialectNotificationProvider"/>

        <toolWindow id="Brikk SQL AST"
                    anchor="right"
                    secondary="true"
                    icon="AllIcons.Toolwindows.ToolWindowStructure"
                    factoryClass="dev.sort.sqltranspiler.AstViewerToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="BrikkSql.NewScratch"
                class="dev.sort.sqltranspiler.lang.NewBrikkSqlScratchAction"
                text="Brikk SQL Scratch"
                description="Creates a .bsql scratch file - the polyglot playground for dialect-marker blocks"
                icon="AllIcons.Nodes.DataTables">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <!-- Direct entry in File | New, right after the platform's Scratch File item
                 (the language popup also offers "Brikk SQL", but this is one click). -->
            <add-to-group group-id="NewGroup" relative-to-action="NewScratchFile" anchor="after"/>
        </action>
        <group id="BrikkSql.EditorMenu" text="SQL Transpiler" popup="true"
               class="com.intellij.ide.actions.NonEmptyActionGroup">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="BrikkSql.ExecuteViaTranspile"
                    class="dev.sort.sqltranspiler.ExecuteViaTranspileAction"
                    text="Execute via Transpilation"
                    description="Transpiles the scope into the attached console's engine dialect, reviews the result (skipped when unchanged since last approval), and runs it"/>
            <action id="BrikkSql.TranspileTo"
                    class="dev.sort.sqltranspiler.TranspileToAction"
                    text="Transpile To..."
                    description="Transpiles the selection (or dialect-marker block, or whole file) to a picked target dialect, with preview and diagnostics"/>
            <action id="BrikkSql.TranspileFrom"
                    class="dev.sort.sqltranspiler.TranspileFromAction"
                    text="Transpile From..."
                    description="Picks the source dialect explicitly (overriding detection), then transpiles into the file's current dialect"/>
        </group>
    </actions>
</idea-plugin>
